---
import type { TrackEntry } from "../../schemas/track";
import TrackHeader from "./TrackHeader.astro";
import SectionHeader from "./SectionHeader.astro";
import ResourceCard from "./ResourceCard.astro";
import ResourcePlaceholder from "./ResourcePlaceholder.astro";
import CamtoolRow from "./CamtoolRow.astro";

interface Props {
  track: TrackEntry;
}

const { track } = Astro.props;
const sortedResources = [...track.resources].sort((a, b) =>
  a.name.localeCompare(b.name)
);
---

<article class="track-index">
  <TrackHeader track={track} />

  <section class="section-block">
    <SectionHeader title="resources" count={sortedResources.length} />
    <div class="resource-grid">
      {sortedResources.map((resource) => <ResourceCard resource={resource} />)}
      <ResourcePlaceholder trackName={track.name} />
    </div>
  </section>

  {
    track.camtools.length > 0 && (
      <section class="section-block">
        <SectionHeader title="camtools" count={track.camtools.length} />
        <div class="camtool-list">
          {track.camtools.map((camtool) => (
            <CamtoolRow camtool={camtool} />
          ))}
        </div>
      </section>
    )
  }
</article>

<style>
  .track-index {
    padding: 3rem 0 5rem;
  }

  .section-block {
    margin-bottom: 3.5rem;
  }

  .camtool-list {
    display: flex;
    flex-direction: column;
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
