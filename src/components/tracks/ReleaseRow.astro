---
import type { Release } from "../../schemas/track";
import { getHostLabel } from "../../utils/url";

interface Props {
  release: Release;
  trackName: string;
}

const { release, trackName } = Astro.props;

const facts = [
  release.lengthKm && `${release.lengthKm} km`,
  release.pits && `${release.pits} pits`,
  release.layouts && `${release.layouts} layouts`,
]
  .filter(Boolean)
  .join(" · ");
---

<div class="release-row">
  <div class="main">
    <div class="title-row">
      <span class="title">{trackName}</span>
      {release.label && <span class="label-tag">{release.label}</span>}
    </div>
    <span class="subtitle">{release.authors.join(", ")}</span>
    {facts && <span class="facts">{facts}</span>}
  </div>

  <div class="destinations">
    {
      release.links.map((link) => (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="destination-link"
        >
          {getHostLabel(link)} ↗
        </a>
      ))
    }
  </div>
</div>

<style>
  .release-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1rem 0.75rem;
    border-bottom: 1px solid var(--border-color);
    border-radius: 0.25rem;
    gap: 1.5rem;
    transition: background-color 0.12s ease;
  }

  .release-row:hover {
    background-color: var(--bg-surface);
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .title {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .label-tag {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-weight: 500;
  }

  .subtitle {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.25;
  }

  .facts {
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin-top: 0.15rem;
    line-height: 1.25;
  }

  .destinations {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    flex-shrink: 0;
    margin-top: 0.12rem;
  }

  .destination-link {
    font-size: 0.75rem;
    color: var(--text-dim);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .destination-link:hover {
    color: var(--text-primary);
  }
</style>
