---
import type { Release } from '../../schemas/track';

interface Props {
  release: Release;
}

const { release } = Astro.props;
const primaryLink = release.links[0];

const facts = [
  release.facts?.lengthKm && `${release.facts.lengthKm} km`,
  release.facts?.pits && `${release.facts.pits} pits`,
  release.facts?.layouts && `${release.facts.layouts} layouts`,
].filter(Boolean).join(' · ');
---

<a
  href={primaryLink?.url}
  target="_blank"
  rel="noopener noreferrer"
  class="release-row"
>
  <div class="main">
    <span class="title">{release.name}</span>
    <span class="subtitle">{release.authors.join(', ')}</span>
    {facts && <span class="facts">{facts}</span>}
  </div>

  {primaryLink && <span class="destination">{primaryLink.host} ↗</span>}
</a>

<style>
  .release-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1rem 0.75rem;
    text-decoration: none;
    border-bottom: 1px solid var(--border-color);
    transition: background-color 0.12s ease;
    border-radius: 0.25rem;
  }

  .release-row:hover {
    background-color: var(--bg-surface);
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .title {
    font-size: 0.95rem;
    font-weight: 550;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .subtitle {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.25;
  }

  .facts {
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin-top: 0.15rem;
    line-height: 1.25;
  }

  .destination {
    font-size: 0.75rem;
    color: #4a4a50;
    white-space: nowrap;
    margin-top: 0.12rem;
    transition: color 0.15s ease;
  }

  .release-row:hover .destination {
    color: var(--text-muted);
  }
</style>
