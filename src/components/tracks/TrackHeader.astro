---
import type { TrackEntry } from "../../schemas/track";
import { getHostLabel } from "../../utils/url";

interface Props {
  track: TrackEntry;
}

const { track } = Astro.props;

const facts = [
  track.lengthKm && `${track.lengthKm} km`,
  track.pits && `${track.pits} pits`,
  track.layouts && `${track.layouts} layouts`,
]
  .filter(Boolean)
  .join(" · ");
---

<header class="track-header">
  <div class="header-main">
    <h1 class="track-title">{track.name}</h1>
    {track.authors && <span class="track-authors">{track.authors.join(", ")}</span>}
    {facts && <span class="track-facts">{facts}</span>}
  </div>

  <div class="destinations">
    {
      track.links && track.links.length > 0 ? (
        track.links.map((link) => (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="destination-link"
          >
            {getHostLabel(link)} ↗
          </a>
        ))
      ) : (
        <span class="base-game-tag">Base Game</span>
      )
    }
  </div>
</header>

<style>
  .track-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 3rem;
    gap: 1.5rem;
  }

  .header-main {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .track-title {
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.1;
  }

  .track-authors {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .track-facts {
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin-top: 0.1rem;
  }

  .destinations {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    flex-shrink: 0;
    margin-top: 0.5rem;
  }

  .destination-link {
    font-size: 0.8125rem;
    color: var(--text-dim);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .destination-link:hover {
    color: var(--text-primary);
  }

  .base-game-tag {
    font-size: 0.75rem;
    color: var(--text-dim);
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--border-color);
    border-radius: 0.25rem;
  }
</style>
