---
import type { Resource, Release } from "../../schemas/track";
import { getHostLabel } from "../../utils/url";

interface Props {
  resource: Resource;
  releases: Release[];
}

const { resource, releases } = Astro.props;
const primaryLink = resource.links[0];

const isSubset =
  releases.length > 1 &&
  resource.for &&
  resource.for.length > 0 &&
  resource.for.length < releases.length;
const subsetLabel = isSubset ? `for ${resource.for?.join(" + ")}` : null;
---

<a
  href={primaryLink}
  target="_blank"
  rel="noopener noreferrer"
  class="resource-card"
>
  <div class="card-top">
    <span class="title">{resource.name}</span>
    {
      primaryLink && (
        <span class="destination">{getHostLabel(primaryLink)} ↗</span>
      )
    }
  </div>

  <div class="card-bottom">
    <span class="authors">{resource.authors.join(", ")}</span>
    <div class="meta-row">
      <span class="kind">{resource.kind}</span>
      {subsetLabel && <span class="compatibility">{subsetLabel}</span>}
    </div>
  </div>
</a>

<style>
  .resource-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.85rem 0.95rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 0.35rem;
    text-decoration: none;
    min-height: 6rem;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .resource-card:hover {
    border-color: var(--text-dim);
    background-color: #19191d;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.35;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .destination {
    font-size: 0.7rem;
    color: var(--text-dim);
    white-space: nowrap;
    margin-top: 0.15rem;
    transition: color 0.15s ease;
    flex-shrink: 0;
  }

  .resource-card:hover .destination {
    color: var(--text-muted);
  }

  .card-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .authors {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .meta-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.75rem;
  }

  .kind {
    color: var(--text-dim);
    text-transform: lowercase;
  }

  .compatibility {
    color: var(--accent);
  }
</style>
